{
  "pass": true,
  "serverUp": true,
  "runtime": {
    "node": "v26.5.0",
    "bun": "1.3.14",
    "mode": "production",
    "port": 32147,
    "command": "bun run start:prod"
  },
  "preconditions": {
    "databaseReachable": true,
    "assistantDocsReindexOnBootNonTrue": true,
    "backupSchedulerDisabled": true,
    "viteDevelopmentUrlsUnset": true,
    "ipAllowlistEmpty": true,
    "periOwnerDiscovery": {
      "staticRouteRegistered": false,
      "enabledRedirects": 0,
      "persistedPages": 0,
      "configuredContentRoute": null
    },
    "configuredHostsVerifiedWithoutValues": true,
    "siteManifestPlaced": true,
    "siteManifestPath": "core/dist/site/manifest.json"
  },
  "builds": {
    "admin": "pass",
    "site": "pass",
    "prototype": "pass",
    "dockerImage": {
      "run": false,
      "reason": "Docker CLI is unavailable in the validation environment; Dockerfile configuration was validated statically."
    }
  },
  "scenarios": [
    {
      "request": "GET /",
      "status": 200,
      "assertion": "Rendered HTML references the built site CSS asset."
    },
    {
      "request": "GET /admin",
      "status": 307,
      "assertion": "Redirect location is /admin/."
    },
    {
      "request": "GET /admin/",
      "status": 200,
      "assertion": "Rendered admin HTML includes X-Frame-Options: DENY, X-Content-Type-Options: nosniff, and Referrer-Policy: no-referrer."
    },
    {
      "request": "GET /admin/api/auth/install/status",
      "status": 200,
      "assertion": "Response is valid JSON and reports installation availability."
    },
    {
      "request": "GET /site/assets/main-DcmGlajF.css",
      "status": 200,
      "assertion": "Response content type is text/css and the built asset is non-empty."
    },
    {
      "request": "GET /peri",
      "status": 404,
      "assertion": "Response is exactly Not Found with no redirect Location header."
    },
    {
      "request": "GET / after /peri",
      "status": 200,
      "assertion": "Server remains healthy after the negative-route smoke."
    }
  ],
  "logsInspected": true,
  "processStopped": true,
  "portReleased": true,
  "containsSecrets": false,
  "serverErrors": [],
  "failures": []
}
