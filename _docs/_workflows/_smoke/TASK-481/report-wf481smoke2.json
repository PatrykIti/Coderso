{
  "pass": true,
  "serverUp": true,
  "scenarios": [
    {
      "id": "s1-inline-accent",
      "variants": [
        {
          "name": "apply-site-accent-via-inline-toolbar",
          "assertions": [
            {
              "kind": "computed-style",
              "selector": "[data-page-editor-text-color-swatch='accent']",
              "expected": "background-color: rgb(245, 158, 11)"
            },
            {
              "kind": "computed-style",
              "selector": "[data-page-editor-block-id='blk_fd00cabcc231'] span[style*='var(--color-accent)']",
              "expected": "color: rgb(245, 158, 11)"
            },
            {
              "kind": "dom-state",
              "selector": "[data-page-editor-content]",
              "expected": "--color-accent: #f59e0b"
            }
          ]
        }
      ]
    },
    {
      "id": "s2-chrome-admin",
      "variants": [
        {
          "name": "editor-chrome-stays-admin-theme",
          "assertions": [
            {
              "kind": "computed-style",
              "selector": "[data-page-editor-block-id='blk_fd00cabcc231']",
              "expected": "outline-color: rgb(124, 58, 237)"
            },
            {
              "kind": "computed-style",
              "selector": "[data-page-editor-ghost='add-block-beside']",
              "expected": "border-color: rgb(234, 231, 224)"
            },
            {
              "kind": "dom-state",
              "selector": "[data-page-editor-block-id='blk_fd00cabcc231']",
              "expected": "--color-accent: var(--accent)"
            },
            {
              "kind": "dom-state",
              "selector": "[data-page-editor-canvas-frame='true']",
              "expected": "no --color-accent (brand not on frame)"
            }
          ]
        }
      ]
    },
    {
      "id": "s3-toolbar-url-custom",
      "variants": [
        {
          "name": "inline-toolbar-url-input-and-custom-color",
          "assertions": [
            {
              "kind": "dom-state",
              "selector": "input[aria-label='Inline link URL']",
              "expected": "focused and value https://coderso.dev"
            },
            {
              "kind": "dom-state",
              "selector": "[data-page-editor-text-color-picker='true']",
              "expected": "enabled (not disabled)"
            },
            {
              "kind": "computed-style",
              "selector": "[data-page-editor-block-id='blk_fd00cabcc231'] span[style*='color']",
              "expected": "color: rgb(225, 29, 72)"
            }
          ]
        }
      ]
    },
    {
      "id": "s4-live-repaint",
      "variants": [
        {
          "name": "cache-bus-repaint-to-new-accent",
          "assertions": [
            {
              "kind": "dom-state",
              "selector": "[data-page-editor-content]",
              "expected": "--color-accent: #16a34a (after PATCH + settingsRedacted broadcast)"
            },
            {
              "kind": "computed-style",
              "selector": "[data-page-editor-block-id='blk_fd00cabcc231'] span[style*='var(--color-accent)']",
              "expected": "color: rgb(22, 163, 74)"
            },
            {
              "kind": "dom-state",
              "selector": "[data-page-editor-block-id='blk_fd00cabcc231']",
              "expected": "--color-accent: var(--accent) (chrome did not bleed brand)"
            }
          ]
        }
      ]
    },
    {
      "id": "s5-cross-device",
      "variants": [
        {
          "name": "tablet-canvas",
          "assertions": [
            {
              "kind": "geometry",
              "selector": "[data-page-editor-canvas-frame='true']",
              "expected": "width: 642px"
            },
            {
              "kind": "dom-state",
              "selector": "[data-page-editor-content]",
              "expected": "--color-accent: #16a34a"
            },
            {
              "kind": "dom-state",
              "selector": "[data-page-editor-content]",
              "expected": "Editing: Tablet · 744px (overrides)"
            }
          ]
        },
        {
          "name": "mobile-canvas",
          "assertions": [
            {
              "kind": "geometry",
              "selector": "[data-page-editor-canvas-frame='true']",
              "expected": "width: 390px"
            },
            {
              "kind": "dom-state",
              "selector": "[data-page-editor-content]",
              "expected": "--color-accent: #16a34a"
            },
            {
              "kind": "dom-state",
              "selector": "[data-page-editor-content]",
              "expected": "Editing: Mobile · 390px (overrides)"
            }
          ]
        }
      ]
    },
    {
      "id": "s6-dark-mode",
      "variants": [
        {
          "name": "admin-dark-mode-parity",
          "assertions": [
            { "kind": "dom-state", "selector": "html.dark", "expected": "dark class present" },
            {
              "kind": "computed-style",
              "selector": "body",
              "expected": "background-color: rgb(24, 23, 26)"
            },
            {
              "kind": "computed-style",
              "selector": "[data-page-editor-block-id='blk_fd00cabcc231']",
              "expected": "outline-color: rgb(139, 92, 246)"
            },
            {
              "kind": "dom-state",
              "selector": "[data-page-editor-content]",
              "expected": "--color-accent: #16a34a"
            }
          ]
        }
      ]
    },
    {
      "id": "s7-publish-front-parity",
      "variants": [
        {
          "name": "published-front-renders-site-accent",
          "assertions": [
            {
              "kind": "computed-style",
              "selector": ":root",
              "expected": "--color-accent: #16a34a"
            },
            {
              "kind": "computed-style",
              "selector": "span",
              "expected": "color: rgb(22, 163, 74) (brand-colored text)"
            },
            {
              "kind": "dom-state",
              "selector": "h1",
              "expected": "content section (page content parity)"
            },
            { "kind": "dom-state", "selector": "title", "expected": "HomePage" }
          ]
        }
      ]
    }
  ],
