# Core
DATABASE_URL=postgres://user:password@localhost:5432/nextless
DB_POOL_MAX=10
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Dev servers
VITE_DEV_SERVER_URL=http://localhost:5173
VITE_SITE_DEV_SERVER_URL=http://localhost:5174

# Security keys (required when enabled)
# HMAC key used for email lookup hash (32+ bytes recommended)
PII_HASH_KEY=
# AES-256-GCM key for email encryption (32 bytes)
PII_ENC_KEY=
# Optional pepper for password hashing (rotation requires password resets)
AUTH_PASSWORD_PEPPER=

# Media secrets
MEDIA_SECRET_MASTER_KEY=
