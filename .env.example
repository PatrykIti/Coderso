# Core
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development
CORE_VERSION=0.1.0

# Database
DATABASE_URL=postgres://user:password@localhost:5432/coderso
DB_POOL_MAX=10

# Admin bootstrap (seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Security
# Force secure cookies (default: true in production)
COOKIE_SECURE=
# HMAC key used for email lookup hash (32+ bytes recommended)
PII_HASH_KEY=
# AES-256-GCM key for email encryption (32 bytes)
PII_ENC_KEY=
# Optional pepper for password hashing (rotation requires password resets)
AUTH_PASSWORD_PEPPER=

# HMAC secret for public form submission nonces (required for public forms)
FORM_SUBMIT_NONCE_SECRET=
# Nonce TTL in minutes (default: 10)
FORM_SUBMIT_NONCE_TTL_MINUTES=

# Media secrets
# Master key for encrypting media provider secrets (32 bytes)
MEDIA_SECRET_MASTER_KEY=

# Media storage (local)
# Default: ./storage/media
MEDIA_STORAGE=local
MEDIA_DIR=./storage/media
MEDIA_BASE_URL=/media
MEDIA_ALLOWED_MIME=
MEDIA_MAX_SIZE_BYTES=

# Media storage (S3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_PREFIX=

# Media storage (Azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_ACCOUNT=
AZURE_KEY=
AZURE_CONTAINER=

# Email
EMAIL_TRANSPORT=mock

# Assistant live provider tests only
# Used only by opt-in integration tests for LLM Guide planner changes.
# Production Assistant/OpenRouter configuration comes from Settings/Integrations connectors.
TEST_OPENROUTER_API_KEY=
TEST_OPENROUTER_MODEL=
TEST_OPENAI_API_KEY=
TEST_OPENAI_MODEL=

# Themes
THEMES_DIR=

# Plugins / Store
PLUGINS_RUNTIME_DIR=
PLUGINS_SAFE_MODE=
PLUGIN_UPDATE_MODE=
PLUGIN_ERROR_THRESHOLD=
PLUGIN_TIMEOUT_MS=
PLUGIN_DOWNLOAD_TIMEOUT_MS=
PLUGIN_MAX_SIZE_MB=
STORE_BASE_URL=
STORE_PUBLIC_KEY=

# Dev servers / Vite
VITE_DEV_SERVER_URL=http://localhost:5173
VITE_SITE_DEV_SERVER_URL=http://localhost:5174
VITE_API_ORIGIN=http://localhost:3000
# Optional: React StrictMode for admin dev UI (`true` enables double-invocation checks)
VITE_ADMIN_STRICT_MODE=
