{
  "name": "admin-default",
  "version": "1.0.0",
  "description": "Default admin UI theme template.",
  "templates": ["page", "content", "error"],
  "tokens": {
    "colors": {
      "primary": "#1d4ed8",
      "secondary": "#0f766e",
      "accent": "#f59e0b"
    },
    "neutrals": {
      "bg": "#ffffff",
      "surface": "#f8fafc",
      "text": "#0f172a"
    },
    "spacing": {
      "xs": "0.25rem",
      "sm": "0.5rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem",
      "2xl": "3rem"
    },
    "radius": {
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "xl": "16px"
    },
    "typography": {
      "sans": "\"IBM Plex Sans\", \"Helvetica Neue\", Arial, sans-serif",
      "display": "\"Space Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem"
    }
  }
}
