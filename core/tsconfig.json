{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun", "vite/client"],
    "paths": {
      "@/*": ["./admin/*"]
    }
  },
  "include": ["admin", "server", "services", "ui", "plugins", "store"]
}
